# ═══════════════════════════════════════════════════════════════════════
# JARVIS — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════
#
# Copy this file to .env to configure JARVIS:
#   cp .env.example .env
#
# Required variables depend on your chosen voice provider.
# .env is already in .gitignore — never commit it.
#
# All boolean values accept: 1, true, yes, on (case-insensitive)
# All boolean false values:  0, false, no, off, or empty
# ═══════════════════════════════════════════════════════════════════════

# ── Voice ─────────────────────────────────────────────────────────────
# Whether voice features are enabled at all.
# Type: boolean     Default: false
VOICE_ENABLED=false

# Direct listening vs. wake-word gating.
#   false (default): JARVIS listens for commands directly — no wake word.
#   true:            the classic wake-gated path (say the wake word first).
# Type: boolean     Default: false
WAKE_WORD_ENABLED=false

# Voice provider to use.
# Options: "system" (Windows TTS, offline, no API key needed)
#          "elevenlabs" (cloud, requires API key + Voice ID)
# Type: string      Default: system
VOICE_PROVIDER=system

# ElevenLabs Voice ID — required when VOICE_PROVIDER=elevenlabs.
# How to find it:
#   1. Go to https://elevenlabs.io/voice-lab
#   2. Select a voice
#   3. Copy the ID from the browser URL (looks like "A2n0deBXrNcraJ2I9mUk")
# Type: string      Default: (empty)
VOICE_ID=

# ElevenLabs API key — required when VOICE_PROVIDER=elevenlabs.
# How to obtain one:
#   1. Sign up at https://elevenlabs.io
#   2. Go to Profile → API Keys
#   3. Create a new API key and copy it here
# Type: string      Default: (empty)
ELEVENLABS_API_KEY=

# ElevenLabs model identifier.
# Type: string      Default: eleven_multilingual_v2
VOICE_MODEL=eleven_multilingual_v2

# Voice synthesis parameters — each between 0.0 and 1.0.
# Stability (0=high variability, 1=stable/robotic)
VOICE_STABILITY=0.5
# Similarity to original voice (0=loose, 1=exact clone)
VOICE_SIMILARITY=0.75
# Style exaggeration (0=none, 1=exaggerated)
VOICE_STYLE=0.0

# Speaker boost — enhances clarity. Applied when using ElevenLabs.
# Type: boolean     Default: true
VOICE_SPEAKER_BOOST=true
VOICE_SPEED=1.2

# Piper — local, offline neural TTS used as the automatic fallback when
# ElevenLabs fails.  The voice model (.onnx + .onnx.json) is downloaded
# manually once, then placed at PIPER_VOICE_MODEL_PATH:
#   python -m piper.download_voices en_US-lessac-medium
# Type: string      Default: models/piper/en_US-lessac-medium.onnx
PIPER_VOICE_MODEL_PATH=models/piper/en_US-lessac-medium.onnx
# Type: string      Default: en_US-lessac-medium
PIPER_VOICE_NAME=en_US-lessac-medium

# ── Push-to-Talk ──────────────────────────────────────────────────────

# ── Speech recognition / wake word ──────────────────────────────────
JARVIS_WHISPER_MODEL=small
JARVIS_WHISPER_THREADS=4
JARVIS_PORCUPINE_KEYWORD=monday

# ── Ollama (LLM Backend) ──────────────────────────────────────────────
# Base URL of the Ollama API server.
# Must start with http:// or https://
OLLAMA_BASE_URL=http://localhost:11434

# Model name to use for inference.
# Must be a model pulled into your local Ollama instance (ollama pull <name>).
OLLAMA_MODEL=qwen2.5:3b

# Request timeout in seconds for Ollama API calls.
# Type: integer > 0   Default: 30
OLLAMA_TIMEOUT=30

# LLM reasoning provider (online by default; Ollama kept as legacy).
# Options: "gemini" (needs GEMINI_API_KEY) or "ollama" (local server).
JARVIS_LLM_PROVIDER=gemini
# Gemini model for online reasoning.
JARVIS_GEMINI_MODEL=gemini-3.5-flash-lite
# Google AI Studio key. NEVER commit a real key; prefer environment export.
#GEMINI_API_KEY=

# ── Microphone ────────────────────────────────────────────────────────
# Overall microphone sensitivity multiplier.
# Type: float >= 0       Default: 1.0
MIC_SENSITIVITY=1.0

# Automatic Gain Control — dynamically adjusts gain to maintain target level.
# Type: boolean          Default: true
MIC_AGC_ENABLED=true

# Target RMS level for AGC (0.001 – 1.0).
# Higher values = louder output; 0.15 is a good starting point.
# Type: float            Default: 0.15
MIC_AGC_TARGET_LEVEL=0.15

# Noise gate — suppresses chunks below the RMS threshold to prevent
# false activations from background noise.
# Type: boolean          Default: true
MIC_NOISE_GATE_ENABLED=true

# RMS threshold for noise gate (0.001 – 0.5).
# Below this value audio is zeroed out entirely.
# Type: float            Default: 0.02
MIC_NOISE_GATE_THRESHOLD=0.02

# ── General ───────────────────────────────────────────────────────────
# Enable debug output (verbose logging, error details in responses).
# Type: boolean     Default: false
DEBUG=false
